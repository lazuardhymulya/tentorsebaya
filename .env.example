# Supabase (Project Settings > API di dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-di-sini
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini

# Dipakai server (cron job, admin action) untuk mengakses Supabase tanpa RLS.
# JANGAN pernah expose key ini ke browser / commit ke git.

# Rahasia untuk menandatangani cookie sesi admin panel. Isi string acak sendiri, min 32 karakter.
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-panjang

# Akun admin awal (dipakai untuk seed lewat SQL / dipakai login panel admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# URL production untuk redirect OAuth (isi setelah deploy ke Vercel), contoh:
# https://tentorsebaya.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Endpoint /api/cron/retry-questions dilindungi secret ini, dicocokkan lewat header
# Authorization: Bearer <CRON_SECRET> yang dikirim Vercel Cron.
CRON_SECRET=ganti-dengan-string-acak-lain
